{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build arquivo ativo",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-std=gnu89",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}